{{#preview-panel class="preview-panel preview-panel-fixed-right col-xs-12 col-sm-7 col-md-6 col-lg-5" showPanel=model.settings.showPanel showOutput=model.settings.showOutput format=model.outputFormat selectOutput='selectOutput' selectPreview='selectPreview'}}
  {{#unless model.isClassicFormat}}
    {{interlude-output doc=model showOutput=model.settings.showOutput}}
  {{else}}
  <div id="interludeTextContent">
    {{#if model.settings.showOutput}}
      <p>[CENTER]■[/CENTER]</p>
      <p>
        [b]Welcome to the Parahumans Online message boards.[/b] <br/>
        You are currently logged in, [u]{{if model.user model.user.name "Placeholder_User"}}[/u] <br/>
        You are viewing: <br/>
        •  Threads you have replied to <br/>
        •  AND Threads that have new replies <br/>
        •  OR private message conversations with new replies <br/>
        •  Thread OP is displayed. <br/>
        •  {{num-to-word model.postsPerPage}} posts per page <br/>
        •  Last ten messages in private message history. <br/>
        •  Threads and private messages are ordered chronologically. <br/>
      </p>
      <p>[CENTER]■[/CENTER]</p>
    {{else}}
      <p style="text-align: center">■</p>
      <p>
        <b>Welcome to the Parahumans Online message boards.</b> <br/>
        You are currently logged in, <u>{{if model.user model.user.name "Placeholder_User"}}</u> <br/>
        You are viewing: <br/>
        •  Threads you have replied to <br/>
        •  AND Threads that have new replies <br/>
        •  OR private message conversations with new replies <br/>
        •  Thread OP is displayed. <br/>
        • &nbsp;{{num-to-word model.postsPerPage}}&nbsp;posts per page <br/>
        •  Last ten messages in private message history. <br/>
        •  Threads and private messages are ordered chronologically. <br/>
      </p>
      <p style="text-align: center">■</p>
    {{/if}}
    {{#each model.threads as |thread|}}
      {{#if model.settings.showOutput}}
        <p>
          [b]♦  Topic: {{thread.name}}[/b]<br/>
          [b]In:  Boards ► {{thread.location}}[/b]<br/>
          [b]{{thread.firstPost.user.name}} [/b]
          {{is-op originalPoster=thread.firstPost.user currentPoster=thread.firstPost.user}}
          {{#each thread.firstPost.user.tags as |tag|}}
            ({{tag.name}})
          {{/each}}<br/>
          Posted On {{moment thread.firstPost.postedOn 'MMM Do YYYY' 'MM/DD/YYYY'}}:<br/>
          {{html-output thread.firstPost.content}}
        </p>

        [indent]
        {{#each thread.posts as |post index|}}

          <p>
          {{thread-page-header
            isOutput=model.settings.showOutput
            postsPerPage=model.postsPerPage
            startPage=thread.startPage
            endPage=thread.endPage
            index=index
            postLength=thread.posts.length}}
          </p>

          <p>
            [b]►{{post.user.name}} [/b]
            {{is-op originalPoster=thread.firstPost.user currentPoster=post.user}}
            {{#each post.user.tags as |tag|}}
              ({{tag.name}})&nbsp;
            {{/each}}<br/>
            Replied On&nbsp;{{moment post.postedOn 'MMM Do YYYY' 'MM/DD/YYYY'}}:<br/>
            {{html-output post.content}}
          </p>

          <p>
          {{thread-page-footer
            isOutput=model.settings.showOutput
            postsPerPage=model.postsPerPage
            startPage=thread.startPage
            endPage=thread.endPage
            index=index
            postLength=thread.posts.length}}
          </p>
        {{/each}}
        [/indent]
        <p>[CENTER]■[/CENTER]</p>
      {{else}}
        <p>
          <b>♦  Topic: {{thread.name}}</b><br/>
          <b>In:  Boards ► {{thread.location}}</b><br/>
          <b>{{thread.firstPost.user.name}} </b>
          {{is-op originalPoster=thread.firstPost.user currentPoster=thread.firstPost.user}}
          {{#each thread.firstPost.user.tags as |tag|}}
            ({{tag.name}})
          {{/each}}<br/>
          Posted On {{moment thread.firstPost.postedOn 'MMM Do YYYY' 'MM/DD/YYYY'}}:<br/>
          {{html-output thread.firstPost.content}}
        </p>

        {{#each thread.posts as |post index|}}

          <p>
          {{thread-page-header
            isOutput=model.settings.showOutput
            postsPerPage=model.postsPerPage
            startPage=thread.startPage
            endPage=thread.endPage
            index=index
            postLength=thread.posts.length}}
          </p>

          <p style="padding-left:30px;">
            <b>►{{post.user.name}} </b>
            {{is-op originalPoster=thread.firstPost.user currentPoster=post.user}}
            {{#each post.user.tags as |tag|}}
              ({{tag.name}})
            {{/each}}<br/>
            Replied On {{moment post.postedOn 'MMM Do YYYY' 'MM/DD/YYYY'}}:<br/>
            {{html-output post.content}}
          </p>

          <p>
          {{thread-page-footer
            isOutput=model.settings.showOutput
            postsPerPage=model.postsPerPage
            startPage=thread.startPage
            endPage=thread.endPage
            index=index
            postLength=thread.posts.length}}
          </p>
        {{/each}}
        <p style="text-align: center">■</p>
      {{/if}}

    {{/each}}
  </div>
  {{/unless}}
{{/preview-panel}}

<div class="container container-left">
  <div class="row">
    <div class="col-xs-12 col-sm-8 col-md-7 col-lg-6">
      <div class="panel panel-default">
        <div class="panel-heading">
          <div class="pull-right" style="padding-top: inherit;">
            {{confirm-delete-button btnSize="" text="Delete this interlude?" action="deleteDoc" param=model.id}}
          </div>
          <h3>{{edit-interlude-title title=model.title action="renameDoc" param=model.id}}</h3>
        </div>
        <div class="panel-body">
          {{! Picking logged-in user perspective}}
          <label for="interlude-perspective-user">Interlude User</label>
          {{#interlude-user-picker
            givenUser= model.user
            availableUsers=model.allUsers
            selectUser="setUserPerspective"
            createUser="createUser"
            param=model.id}}

          {{/interlude-user-picker}}

          {{#if model.user}}
            {{! this is the added results box}}
            {{interlude-tags-display
              user=model.user
              removeTagFromUser="removeTagFromUser"}}

            {{interlude-tags-picker
              availableTags=model.allTags
              givenTags=model.user.tags
              selectTag="addTagToUser"
              createTag="createTag"
              param=model.user.id}}
          {{/if}}
        </div>

        <ul class="list-group">
          {{! shows the tags available to this specific user}}

          <li class="list-group-item">
            {{! Picking the number of posts displayed per group.}}
            <label for="interlude-posts-per-page">Posts per Page</label>
            {{#select-post-per-page
              selections=model.settings.postsPerPageSelections
              selected=model.postsPerPage
              action="changePostsPerPage"
              param=model.id}}

            {{/select-post-per-page }}
          </li>
          <li class="list-group-item">
            <label>Output Format</label>
            <div class="btn-group btn-group-justified" role="group" aria-label="Output format">
              <a class="btn btn-default btn-sm {{if model.isClassicFormat 'active'}}" title="The original PHO-style BBCode." {{action "setDocOption" model "outputFormat" "classic"}}>Classic PHO</a>
              <a class="btn btn-default btn-sm {{if (eq-str model.outputFormat 'forum') 'active'}}" title="XenForo BBCode laid out like forum posts, for SpaceBattles, Sufficient Velocity and Questionable Questing." {{action "setDocOption" model "outputFormat" "forum"}}>Forum BBCode</a>
              <a class="btn btn-default btn-sm {{if (eq-str model.outputFormat 'ao3') 'active'}}" title="HTML plus a work skin that makes the chapter look like a forum on AO3." {{action "setDocOption" model "outputFormat" "ao3"}}>AO3 Forum</a>
            </div>
            {{#unless model.isClassicFormat}}
              <div class="output-options">
                <label for="interlude-forum-name">Forum Name</label>
                {{input id="interlude-forum-name" class="form-control input-sm" value=model.forumName placeholder="Parahumans Online" focus-out="saveDoc"}}

                <label>Theme</label>
                <div class="theme-picker" role="group" aria-label="Theme">
                  {{#each forumThemes as |theme|}}
                    <a class="btn btn-default btn-sm {{if (eq-str model.forumTheme theme.key) 'active'}}" title={{theme.label}} {{action "setDocOption" model "forumTheme" theme.key}}>
                      <span class="theme-swatch" style={{theme.swatch}}></span> {{theme.name}}
                    </a>
                  {{/each}}
                </div>

                <label>Avatars</label>
                <div class="btn-group btn-group-justified" role="group" aria-label="Avatars">
                  {{#each avatarStyles as |style|}}
                    <a class="btn btn-default btn-sm {{if (eq-str model.avatarStyle style.key) 'active'}}" title={{style.label}} {{action "setDocOption" model "avatarStyle" style.key}}>{{style.name}}</a>
                  {{/each}}
                </div>
                <span class="help-block">Image avatars come from DiceBear (dicebear.com), loaded by whoever reads the post. On AO3, Initials and Text are drawn by the work skin and load nothing.</span>
                {{#if (eq-str model.outputFormat 'forum')}}
                  <span class="help-block">Forum BBCode can't set the forum's own colours. The theme only changes the preview, so pick the one closest to the board you post on.</span>

                  <label>Post Layout</label>
                  <div class="btn-group btn-group-justified" role="group" aria-label="Post layout">
                    <a class="btn btn-default btn-sm {{if (eq-str model.bbLayout 'stacked') '' 'active'}}" title="User info in a column on the left, like the desktop forum." {{action "setDocOption" model "bbLayout" "sidebar"}}>Sidebar</a>
                    <a class="btn btn-default btn-sm {{if (eq-str model.bbLayout 'stacked') 'active'}}" title="User info in a header row above the post. Reads better on phones." {{action "setDocOption" model "bbLayout" "stacked"}}>Stacked</a>
                  </div>
                {{/if}}
              </div>
            {{/unless}}
          </li>
        </ul>
      </div>
    </div>
  </div>
  {{#each model.threads as |thread|}}
    <div class="row">
      <div class="col-xs-12 col-sm-8 col-md-7 col-lg-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            <div class="pull-right" style="padding-top: 5px;">
              {{confirm-delete-button
                btnSize="btn-sm"
                text="Delete this thread?"
                action="deleteThread"
                param=thread.id}}
            </div>
            <h4>{{edit-interlude-title title=thread.name action="renameThread" param=thread.id}}</h4>
          </div>

          <div class="panel-body">
            {{board-location
              location=thread.location
              thread=thread
              saveChange='saveThreadLocation'}}<br/>

            <label>Original Poster</label>

            {{#interlude-user-picker
              givenUser= thread.firstPost.user
              availableUsers=model.allUsers
              selectUser="setPostUser"
              createUser="createPostUser"
              param=thread.firstPost}}

            {{/interlude-user-picker}}

            {{#if thread.firstPost.user}}
              {{! this is the added results box}}
              {{interlude-tags-display
                user=thread.firstPost.user
                removeTagFromUser="removeTagFromUser"}}

              {{interlude-tags-picker
                availableTags=model.allTags
                givenTags=thread.firstPost.user.tags
                selectTag="addTagToUser"
                createTag="createTag"
                param=thread.firstPost.user.id}}
            {{/if}}

            <hr class="thin"/>
            <label>Post Date</label>
            {{#post-date-picker}}
              {{pikaday-input
                class="form-control"
                value=thread.firstPost.postedOn
                format="MM/DD/YYYY"
                onChange="setPostDate"
                target=thread.firstPost}}
            {{/post-date-picker}}

            <hr class="thin"/>
            <label>Post Content</label>
            {{post-editor
              post=thread.firstPost
              postContent=thread.firstPost.content
              onChange="setPostConent"}}

            <hr class="thin"/>
            <div class="row">
              <div class="col-xs-6">
                <label>Start Page</label>
                {{thread-page-start-picker
                  startPage=thread.startPage
                  min=1
                  thread=thread
                  onChange="saveThreadStartPage"}}
              </div>
              <div class="col-xs-6">
                <label>End Page</label>
                {{thread-page-end-picker
                  endPage=thread.endPage
                  startPage=thread.startPage
                  numPosts=thread.posts.length
                  postsPerPage=model.postsPerPage
                  thread=thread
                  onChange="saveThreadEndPage"}}
              </div>
            </div>
          </div>

          {{#sortable-group tagName="ul" class="list-group" onChange="reorderItems" model=thread as |group|}}
            {{#each thread.posts as |post|}}
              {{#sortable-item tagName="li" class="list-group-item" model=post group=group handle=".handle"}}
                <div class="pull-right">
                  {{confirm-delete-button
                    btnSize="btn-xs"
                    text="Delete this post?"
                    action="deletePost"
                    param=post}}
                </div>

                <label >
                  {{fa-icon "arrows" border=true classNames="handle"}} Responding User
                </label>
                <hr class="thin"/>

                {{#interlude-user-picker
                  givenUser= post.user
                  availableUsers=model.allUsers
                  selectUser="setPostUser"
                  createUser="createPostUser"
                  param=post}}

                {{/interlude-user-picker}}

                {{#if post.user}}
                  {{! this is the added results box}}
                  {{interlude-tags-display
                    user=post.user
                    removeTagFromUser="removeTagFromUser"}}

                  {{interlude-tags-picker
                    availableTags=model.allTags
                    givenTags=post.user.tags
                    selectTag="addTagToUser"
                    createTag="createTag"
                    param=post.user.id}}
                {{/if}}

                <hr class="thin"/>
                <label>Reply Date</label>
                {{#post-date-picker}}
                  {{pikaday-input
                    class="form-control"
                    value=post.postedOn
                    format="MM/DD/YYYY"
                    onChange="setPostDate"
                    target=post}}
                {{/post-date-picker}}

                <hr class="thin"/>
                <label>Post Content</label>
                {{post-editor
                  post=post
                  postContent=post.content
                  onChange="setPostConent"}}
              {{/sortable-item}}
            {{/each}}
          {{/sortable-group}}
          <li class="list-group-item">
            <button class="btn btn-primary btn-xs" {{action "createPost" thread}}>
              {{fa-icon "plus-square"}} Add New Post
            </button>
          </li>
        </div>
      </div>
    </div>
  {{/each}}
  <button class="btn btn-primary" {{action "createThread" model}}>
    {{fa-icon "plus-square"}} Add New Thread
  </button>
</div>

{{outlet}}
